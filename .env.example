DATABASE_URL="file:./dev.db"
PORT=8787

# Opsional di frontend (default http://localhost:8787)
# VITE_API_URL=http://localhost:8787

# Kunci API sync (server). Kosong = terbuka (dev).
# SEGARA_API_TOKEN=ubah-ini-jadi-rahasia

# Token yang dikirim client (harus sama dengan SEGARA_API_TOKEN).
# Bisa juga diisi lewat Pengaturan → Token sync.
# VITE_API_TOKEN=ubah-ini-jadi-rahasia

# Origin yang diizinkan CORS (koma-pisah). Default: localhost Vite.
# SEGARA_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
