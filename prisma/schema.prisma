generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Satu baris menyimpan seluruh workspace JSON (pages + blocks).
model WorkspaceSnapshot {
  id        String   @id @default("default")
  data      String
  updatedAt DateTime @updatedAt
}

/// Link baca-saja ke satu halaman (snapshot live dari workspace).
model ShareLink {
  token     String   @id
  pageId    String
  createdAt DateTime @default(now())
}
