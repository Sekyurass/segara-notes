generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Satu baris per workspace id (multi-user / multi-profile).
model WorkspaceSnapshot {
  id        String   @id @default("default")
  data      String
  updatedAt DateTime @updatedAt
}

/// Link share — canEdit mengizinkan PUT halaman.
model ShareLink {
  token       String   @id
  pageId      String
  workspaceId String   @default("default")
  canEdit     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
